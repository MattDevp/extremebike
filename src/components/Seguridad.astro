---
import {Image} from "astro:assets";
import cadenaSeguridadBicicletaRojoTransparente from "../assets/img/cadena-seguridad-bicicleta-rojo-transparente.jpeg"
import cadenaSeguridadBicicletaRojo from "../assets/img/cadena-seguridad-bicicleta-rojo.jpeg"
import cadenaSeguridadBicicletaVerde from "../assets/img/cadena-seguridad-bicicleta-verde.jpeg"
---
<div class="container mx-auto p-4">
<!-- Contenedor Flex con gap para espaciado -->
<div class="flex flex-wrap -m-2">
    
    <!-- Imagen 1 -->
    <div class="p-2 w-full sm:w-1/2 md:w-1/3 lg:w-1/4">
    <div class="h-full overflow-hidden rounded-lg shadow-lg">
        <Image class="lg:h-48 md:h-36 w-full object-cover object-center" src={cadenaSeguridadBicicletaRojoTransparente} alt="cadena seguridad bicicleta rojo transparente">
    </div>
    </div>

    <!-- Imagen 2 -->
    <div class="p-2 w-full sm:w-1/2 md:w-1/3 lg:w-1/4">
    <div class="h-full overflow-hidden rounded-lg shadow-lg">
        <Image class="lg:h-48 md:h-36 w-full object-cover object-center" src={cadenaSeguridadBicicletaRojo} alt="cadena seguridad bicicleta rojo">
    </div>
    </div>

    <!-- Imagen 3 -->
    <div class="p-2 w-full sm:w-1/2 md:w-1/3 lg:w-1/4">
    <div class="h-full overflow-hidden rounded-lg shadow-lg">
        <Image class="lg:h-48 md:h-36 w-full object-cover object-center" src={cadenaSeguridadBicicletaVerde} alt="cadena seguridad bicicleta verde">
    </div>
    </div>


</div>
</div>
