---
import {Image} from "astro:assets";
import cassetteShimano from "../assets/img/cassette-shimano.jpeg"
import bielaShimano from "../assets/img/biela-shimano.jpeg"
import reparacionMarcoVenzo from "../assets/img/reparacion-marco-venzo.jpeg"
import neumaticos from "../assets/img/neumaticos.jpeg"
import retiroBicicletas from "../assets/img/retiro-bicicletas.jpeg"
import limpiezaMarcoBicicleta from "../assets/img/limpieza-marco-bicicleta.jpeg"
import cassetteBicicletaEclipse from "../assets/img/cassette-bicicleta-eclipse.jpeg"
import marcoVenzo from "../assets/img/marco-venzo.jpeg"
import revisionEnTaller from "../assets/img/revision-en-taller.jpeg"
---

<div class="carrusel mt-20">
    <div class="elememto"><Image src={cassetteShimano} alt="cassette-shimano"></div>
    <div class="elememto"><Image src={bielaShimano} alt="biela-shimano"></div>
    <div class="elememto"><Image src={reparacionMarcoVenzo} alt="reparacion-marco-venzo"></div>
    <div class="elememto"><Image src={neumaticos} alt="neumaticos"></div>
    <div class="elememto"><Image src={retiroBicicletas} alt="retiro"></div>
    <div class="elememto"><Image src={limpiezaMarcoBicicleta} alt="limpieza"></div>
    <div class="elememto"><Image src={cassetteBicicletaEclipse} alt="cassette-bicicleta-eclipse"></div>
    <div class="elememto"><Image src={marcoVenzo} alt="marco-venzo"></div>
    <div class="elememto"><Image src={revisionEnTaller} alt="revision-en-taller"></div>
</div>

<style>
	.carrusel {
        display: flex;
        flex-wrap: nowrap;
        overflow: scroll;
        border-style: solid;
        border-color: green;
        
    }

    .elememto {
        flex: 1 0 auto;
        margin: 0 10px;
        background-color: black;
        width: 170px;
        height: 170px;
        
    }
    img {
        object-fit: cover;
        border-radius: 10px;
        width: 140px;
        height: 140px;
        transition: border-radius 0.6s ease;
    }
    
    img:hover{
        transform: scale(1.1);
        border-radius: 20px;
        transition: 0.4s ease;
    }
</style>